# Local development database. Use a MySQL URL for deployment.
DATABASE_URL=sqlite:///./attendease_dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ATTENDANCE_TIMEZONE=Asia/Kolkata

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=
FACE_SIMILARITY_THRESHOLD=0.363

# Optional custom in-process liveness provider; otherwise the bundled MiniFASNet
# models run locally on the backend. Custom providers must not forward biometric
# frames outside your approved data boundary.
# Format: python_module:function_name; accepts instruction= and frames= and returns
# {"live": bool, "score": float | None}.
LIVENESS_PROVIDER=

# Use a Google App Password for Gmail; SMTP_FROM is the visible sender (defaults to SMTP_USERNAME).
# SMTP credentials are required to send OTPs; OTPs are never returned by the API.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
